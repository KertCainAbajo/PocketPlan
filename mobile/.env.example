# Base URL of the Laravel API. EXPO_PUBLIC_ values are bundled into the app,
# so never put secrets here.
#   Android emulator:  http://10.0.2.2:8000/api/v1   (10.0.2.2 = your PC's localhost)
#   Physical phone:    http://<your-PC-LAN-IP>:8000/api/v1  (run `php artisan serve --host=0.0.0.0`)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

